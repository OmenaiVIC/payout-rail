# BOS payout rail — environment

DATABASE_URL=postgres://user:pass@host:5432/payout_rail
# NEON_DRIVER=serverless        # use @neondatabase/serverless driver
# VERCEL=1                      # deploy on Vercel (@vercel/node)

# Stacks burn leg
PAYOUT_NETWORK=testnet
# PAYOUT_HIRO_API_URL=https://api.testnet.hiro.so
# PAYOUT_USDCX_CONTRACT=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.usdcx
PAYOUT_TX_SIGNING_KEY=
PAYOUT_API_BASE_URL=http://localhost:3001

# Adapters
BRIDGE_ADAPTER_ENV=xreserve
# XRESERVE_PROTOCOL_CONTRACT=
XRESERVE_WEBHOOK_SECRET=
YELLOW_CARD_API_URL=
YELLOW_CARD_API_KEY=
YELLOW_CARD_SECRET_KEY=
YELLOW_CARD_ENV=
YELLOW_CARD_WEBHOOK_SECRET=

# Payout provider selection (config layer only)
# Names the adapter published on ctx.adapters. Defaults to yellowcard.
# WARNING: this does NOT route the payout leg — that is still hard-wired to
# ctx.adapters.yellowcard (backlog P-1). Yellow Card remains the primary NGN
# payout provider.
# PAYOUT_PROVIDER=yellowcard

# Flutterwave — USDC-to-wallet disbursement adapter (Sprint 12).
# NOT an NGN bank payout: the v3 body debits NGN and delivers USDC to a POLYGON
# wallet address. See docs/flutterwave-api-reference.md §0.
# v3 bearer secret key. Server-side only. Never commit, never log.
FLW_SECRET_KEY=
# v3 public key. RESERVED — not read by flutterwaveAdapter.js (plan decision D-3)
FLW_PUBLIC_KEY=
# v3 encryption key. RESERVED — not read by flutterwaveAdapter.js (plan decision D-3)
FLW_ENCRYPTION_KEY=
# Webhook verification hash for the `verif-hash` header.
# FAIL CLOSED: if unset, every Flutterwave webhook is rejected with 401.
# SECURITY: verif-hash is a STATIC SHARED SECRET compared as a plain string, not
# an HMAC. It authenticates the sender only — no payload integrity, no replay
# protection. The load-bearing control is the local idempotency_key UNIQUE
# constraint, not this value. Rotate on a schedule; never log it or the header.
FLW_SECRET_HASH=
# Merchant ID sent as `account_number` on POST /v3/transfers.
# This is the MERCHANT's own id, not the recipient's.
FLW_MERCHANT_ID=
FLW_BASE_URL=https://api.flutterwave.com/v3

# BOS behavior
BOS_RECIPIENT_REGISTRY=null
# BOS_PIPELINE_INTERVAL_MS=30000
# BOS_PIPELINE_BATCH_SIZE=25
# BOS_DAILY_PAYOUT_CAP_USD=10000
# BOS_MAX_PER_DISBURSEMENT_USD=1000
# DEFAULT_USDCX_NGN_RATE=1650

# Monitoring / ops
# SMTP_USER=
# SMTP_PASS=
# BOS_ALERT_EMAIL_RECIPIENTS=
# SLACK_BOS_WEBHOOK_URL=
# CRON_SECRET=
# CORS_ORIGIN=*
NODE_ENV=development
PORT=3001