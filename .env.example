# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/payout_rail
TEST_DATABASE_URL=

# JWT & Auth
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# API Keys - Mock/Development (replace with real values in production)
BOS_API_BASE_URL=http://localhost:3001
BOS_API_TOKEN=dev-token-123

# xReserve Configuration
XRESERVE_API_KEY=your-xreserve-api-key-here
XRESERVE_API_SECRET=your-xreserve-api-secret-here
XRESERVE_WEBHOOK_SECRET=your-xreserve-webhook-secret-here
XRESERVE_ENVIRONMENT=sandbox

# Yellow Card Configuration
YELLOW_CARD_API_KEY=your-yellow-card-api-key-here
YELLOW_CARD_API_SECRET=your-yellow-card-api-secret-here
YELLOW_CARD_WEBHOOK_SECRET=your-yellow-card-webhook-secret-here
YELLOW_CARD_BASE_URL=https://sandbox.yellowcard.io
YELLOW_CARD_ENVIRONMENT=sandbox

# Flutterwave Configuration
FLW_PUBLIC_KEY=your-flutterwave-public-key-here
FLW_SECRET_KEY=your-flutterwave-secret-key-here
FLW_SECRET_HASH=your-flutterwave-secret-hash-here
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_ENVIRONMENT=sandbox

# Breet Configuration
BREET_APP_ID=
BREET_APP_SECRET=
BREET_MERCHANT_REF=
BREET_WEBHOOK_SECRET=
BREET_BASE_URL=https://api.breet.io/v1
BREET_ENV=sandbox
BREET_WITHDRAWAL_PIN=

# Stacks/USDC Configuration
STACKS_NETWORK=testnet
USDC_CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.usdcx
BRIDGE_CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.bridge
TRACKER_CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.tracker
BRIDGE_WALLET_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
PRIV_KEY=
RPC_URL=https://api.testnet.hiro.so

# Monitoring
MONITORING_POLL_INTERVAL=60000
MONITORING_MAX_RETRIES=3

# Feature Flags
ENABLE_YELLOWCARD=true
ENABLE_FLUTTERWAVE=true
PAYOUT_PROVIDER=yellowcard

# Webhook Allowlist
WEBHOOK_ALLOWLIST=0.0.0.0/0