{
  "name": "payout-rail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BOS (Bridge Orchestration Service) payout subsystem extracted from CineX backend — burn → attestation → destination release → payout state machine on Postgres.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "demo:payout:ngn": "node scripts/demo-payout-ngn.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@stacks/network": "^6.17.0",
    "@stacks/transactions": "^6.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}